<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light (used when the system is in day mode and theme = System) -->
    <style name="Theme.StreamLite" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sl_accent_light</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DCE7FF</item>
        <item name="colorOnPrimaryContainer">#0B2A66</item>
        <item name="colorSecondaryContainer">#DCE7FF</item>
        <item name="colorOnSecondaryContainer">#0B2A66</item>
        <item name="colorSurface">@color/sl_card_light</item>
        <item name="colorOnSurface">@color/sl_text_light</item>
        <item name="colorSurfaceVariant">@color/sl_card_high_light</item>
        <item name="colorOnSurfaceVariant">@color/sl_text2_light</item>
        <item name="colorOutline">@color/sl_outline_light</item>
        <item name="colorSurfaceContainerLow">@color/sl_card_light</item>
        <item name="colorSurfaceContainer">@color/sl_card_light</item>
        <item name="colorSurfaceContainerHigh">@color/sl_card_high_light</item>
        <item name="colorSurfaceContainerHighest">@color/sl_card_high_light</item>
        <item name="android:colorBackground">@color/sl_bg_light</item>
        <item name="android:windowBackground">@color/sl_bg_light</item>
        <item name="android:statusBarColor">@color/sl_bg_light</item>
        <item name="android:navigationBarColor">@color/sl_bg_light</item>
        <item name="slBg">@color/sl_bg_light</item>
        <item name="slCard">@color/sl_card_light</item>
        <item name="slCardHigh">@color/sl_card_high_light</item>
        <item name="slOutline">@color/sl_outline_light</item>
        <item name="slText2">@color/sl_text2_light</item>
    </style>

    <!-- Pure black variant for OLED screens -->
    <style name="Theme.StreamLite.Amoled" parent="Theme.StreamLite">
        <item name="colorPrimary">@color/sl_accent</item>
        <item name="colorOnPrimary">@color/sl_on_accent_dark</item>
        <item name="colorPrimaryContainer">#1E3A6E</item>
        <item name="colorOnPrimaryContainer">#D6E3FF</item>
        <item name="colorSecondaryContainer">#1E3A6E</item>
        <item name="colorOnSecondaryContainer">#D6E3FF</item>
        <item name="colorSurface">@color/sl_card_amoled</item>
        <item name="colorOnSurface">@color/sl_text_dark</item>
        <item name="colorSurfaceVariant">@color/sl_card_high_amoled</item>
        <item name="colorOnSurfaceVariant">@color/sl_text2_dark</item>
        <item name="colorOutline">@color/sl_outline_amoled</item>
        <item name="colorSurfaceContainerLow">@color/sl_card_amoled</item>
        <item name="colorSurfaceContainer">@color/sl_card_amoled</item>
        <item name="colorSurfaceContainerHigh">@color/sl_card_high_amoled</item>
        <item name="colorSurfaceContainerHighest">@color/sl_card_high_amoled</item>
        <item name="android:colorBackground">@color/sl_bg_amoled</item>
        <item name="android:windowBackground">@color/sl_bg_amoled</item>
        <item name="android:statusBarColor">@color/sl_bg_amoled</item>
        <item name="android:navigationBarColor">@color/sl_bg_amoled</item>
        <item name="slBg">@color/sl_bg_amoled</item>
        <item name="slCard">@color/sl_card_amoled</item>
        <item name="slCardHigh">@color/sl_card_high_amoled</item>
        <item name="slOutline">@color/sl_outline_amoled</item>
        <item name="slText2">@color/sl_text2_dark</item>
    </style>

    <!-- Player is always dark -->
    <style name="Theme.StreamLite.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/sl_accent</item>
        <item name="colorOnPrimary">@color/sl_on_accent_dark</item>
        <item name="colorPrimaryContainer">#1E3A6E</item>
        <item name="colorOnPrimaryContainer">#D6E3FF</item>
        <item name="colorSecondaryContainer">#1E3A6E</item>
        <item name="colorOnSecondaryContainer">#D6E3FF</item>
        <item name="colorSurface">@color/sl_card_dark</item>
        <item name="colorOnSurface">@color/sl_text_dark</item>
        <item name="colorSurfaceVariant">@color/sl_card_high_dark</item>
        <item name="colorOnSurfaceVariant">@color/sl_text2_dark</item>
        <item name="colorOutline">@color/sl_outline_dark</item>
        <item name="colorSurfaceContainerLow">@color/sl_card_dark</item>
        <item name="colorSurfaceContainer">@color/sl_card_dark</item>
        <item name="colorSurfaceContainerHigh">@color/sl_card_high_dark</item>
        <item name="colorSurfaceContainerHighest">@color/sl_card_high_dark</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="slBg">#000000</item>
        <item name="slCard">@color/sl_card_dark</item>
        <item name="slCardHigh">@color/sl_card_high_dark</item>
        <item name="slOutline">@color/sl_outline_dark</item>
        <item name="slText2">@color/sl_text2_dark</item>
    </style>

    <style name="SL.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/slCard</item>
        <item name="strokeColor">?attr/slOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="SL.Section" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SL.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SL.Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">?attr/slText2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SL.Switch" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SL.IconBtn" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PL.Icon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PL.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_pill_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
