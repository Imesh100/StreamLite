<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="#FFFFFF"
        app:indicatorSize="48dp" />

    <TextView
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:maxWidth="520dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_pill"
        android:lineSpacingExtra="1dp"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:typeface="monospace"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="22dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/PL.Icon"
                android:contentDescription="Back"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPip"
                style="@style/PL.Icon"
                android:contentDescription="Picture in picture"
                android:src="@drawable/ic_pip" />

            <ImageButton
                android:id="@+id/btnSub"
                style="@style/PL.Icon"
                android:contentDescription="Subtitles"
                android:src="@drawable/ic_subtitles" />

            <ImageButton
                android:id="@+id/btnAudio"
                style="@style/PL.Icon"
                android:contentDescription="Audio track"
                android:src="@drawable/ic_audio" />

            <ImageButton
                android:id="@+id/btnMore"
                style="@style/PL.Icon"
                android:contentDescription="More"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRew"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="Back 10 seconds"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rewind" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="Play or pause"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnFwd"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_btn"
                android:contentDescription="Forward 10 seconds"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="22dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/posText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="@color/sl_accent"
                    android:secondaryProgressTint="#66FFFFFF"
                    android:thumbTint="@color/sl_accent" />

                <TextView
                    android:id="@+id/durText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnLock"
                    style="@style/PL.Icon"
                    android:contentDescription="Lock controls"
                    android:src="@drawable/ic_lock_open" />

                <TextView
                    android:id="@+id/btnSpeed"
                    style="@style/PL.Pill"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="1x" />

                <ImageButton
                    android:id="@+id/btnSize"
                    style="@style/PL.Icon"
                    android:contentDescription="Screen size"
                    android:src="@drawable/ic_aspect" />

                <ImageButton
                    android:id="@+id/btnRotate"
                    style="@style/PL.Icon"
                    android:contentDescription="Rotate (hold for menu)"
                    android:src="@drawable/ic_rotate" />

                <ImageButton
                    android:id="@+id/btnStats"
                    style="@style/PL.Icon"
                    android:contentDescription="Stats"
                    android:src="@drawable/ic_stats" />

                <ImageButton
                    android:id="@+id/btnTune"
                    style="@style/PL.Icon"
                    android:contentDescription="Brightness and volume"
                    android:src="@drawable/ic_tune" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/lockBtn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_circle_btn"
        android:contentDescription="Hold to unlock"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />
</FrameLayout>
